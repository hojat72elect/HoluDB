    C --> D["Database Core"]
    D --> E["Catalog (tables and schemas)"]
    D --> F["Indexes (B+ tree)"]
    D --> G["Storage (pages and records)"]
    D --> H["Transactions (logging and recovery)"]
    D --> I["OS I/O (Node fs APIs, database file)"]